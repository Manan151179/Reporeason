# Copy to .env and fill in real values. Loaded via python-dotenv (load_dotenv).

# GitHub personal access token — c3/github_client.py (GitHub repo search)
GITHUB_TOKEN=ghp_your_token_here

# Neo4j connection — graphsearch/graph_builder.py and graph_expand.py
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
